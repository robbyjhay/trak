// Trak production schema — auth + full domain (Phases 0–4).
// Provider: PostgreSQL. IDs: UUID.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  head
  member
}

enum AuthTokenType {
  password_reset
  email_verify
  invite
  initial_password
}

enum AuditAction {
  user_create
  user_update
  user_delete
  user_activate
  user_deactivate
  role_change
  password_reset_request
  password_reset_complete
  password_change
  login
  logout
  session_revoke
  invite_create
  invite_accept
  activity_create
  activity_update
  activity_delete
  activity_complete
  activity_miss
  report_generate
  settings_change
}

enum ActivityType {
  Meeting
  Project
  Program
  Task
}

enum ActivityStatus {
  pending
  completed
  missed
}

enum DailyLogStatus {
  pending
  submitted
}

enum AttendeeSource {
  unit
  manual
  link
}

enum AttachmentKind {
  evidence
  invoice
}

enum NotificationType {
  comment
  dm
  activity_created
  activity_completed
  activity_missed
  broadcast
  mention
}

// ---------------------------------------------------------------------------
// Auth / account (Phase 0)
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique @db.VarChar(64)
  usernameNormalized String    @unique @map("username_normalized") @db.VarChar(64)
  email              String?   @unique @db.VarChar(255)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  role               UserRole
  isSecretary        Boolean   @default(false) @map("is_secretary")
  isCorps            Boolean   @default(false) @map("is_corps")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz(3)
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile     UserProfile?
  sessions    Session[]
  authTokens  AuthToken[]
  preferences UserPreferences?

  activitiesCreated   Activity[]               @relation("ActivityCreatedBy")
  activitiesDelegated Activity[]               @relation("ActivityDelegatedBy")
  comments            Comment[]                @relation("CommentAuthor")
  responsibilities    Responsibility[]         @relation("ResponsibilityCreatedBy")
  directMessagesAsA   DirectMessage[]          @relation("DirectMessageParticipantA")
  directMessagesAsB   DirectMessage[]          @relation("DirectMessageParticipantB")
  directMessagesSent  DirectMessage[]          @relation("DirectMessageSender")
  communityMessages   CommunityMessage[]       @relation("CommunityMessageSender")
  communityMentions   CommunityMessageMention[] @relation("CommunityMessageMentionUser")
  broadcasts          Broadcast[]              @relation("BroadcastSender")
  callRecordsAsA      CallRecord[]             @relation("CallParticipantA")
  callRecordsAsB      CallRecord[]             @relation("CallParticipantB")
  callRecordsFrom     CallRecord[]             @relation("CallFrom")
  notifications       Notification[]           @relation("UserNotification")
  auditEvents         AuditEvent[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model UserProfile {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  name          String    @db.VarChar(200)
  phone         String    @default("") @db.VarChar(40)
  designation   String    @default("") @db.VarChar(200)
  gradeLevel    String    @default("") @map("grade_level") @db.VarChar(40)
  sex           String    @default("") @db.VarChar(32)
  stateOfOrigin String    @default("") @map("state_of_origin") @db.VarChar(100)
  dateJoined    DateTime? @map("date_joined") @db.Date
  corpsEnd      DateTime? @map("corps_end") @db.Date
  color         String    @default("#0e6b47") @db.VarChar(16)
  photoKey      String?   @map("photo_key") @db.VarChar(512)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([name])
  @@map("user_profiles")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  type       AuthTokenType
  tokenHash  String        @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?     @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  meta       Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model UserPreferences {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @map("user_id") @db.Uuid
  notificationsEnabled   Boolean  @default(true) @map("notifications_enabled")
  emailNotifications     Boolean  @default(true) @map("email_notifications")
  dmNotifications        Boolean  @default(true) @map("dm_notifications")
  broadcastNotifications Boolean  @default(true) @map("broadcast_notifications")
  activityNotifications  Boolean  @default(true) @map("activity_notifications")
  locale                 String   @default("en-NG") @db.VarChar(16)
  timezone               String   @default("Africa/Lagos") @db.VarChar(64)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ---------------------------------------------------------------------------
// Domain (Phase 1+)
// ---------------------------------------------------------------------------

model Responsibility {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(16)
  name        String   @db.VarChar(200)
  description String   @db.Text
  deliverables Json    @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy  User?                    @relation("ResponsibilityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  activities ActivityResponsibility[]

  @@map("responsibilities")
}

model Activity {
  id                  String         @id @default(uuid()) @db.Uuid
  title               String         @db.VarChar(300)
  type                ActivityType
  description         String         @default("") @db.Text
  createdById         String         @map("created_by_id") @db.Uuid
  delegatedById       String?        @map("delegated_by_id") @db.Uuid
  startDate           DateTime       @map("start_date") @db.Date
  endDate             DateTime       @map("end_date") @db.Date
  startTime           String         @map("start_time") @db.VarChar(8)
  endTime             String         @default("") @map("end_time") @db.VarChar(8)
  location            String         @default("") @db.VarChar(300)
  status              ActivityStatus @default(pending)
  hidden              Boolean        @default(false)
  hasBudget           Boolean        @default(false) @map("has_budget")
  estimatedAmountNgn  Decimal?       @map("estimated_amount_ngn") @db.Decimal(14, 2)
  initiativeTeamwork  String         @default("") @map("initiative_teamwork") @db.Text
  challenges          String         @default("") @db.Text
  outcomes            String         @default("") @db.Text
  nextSteps           String         @default("") @map("next_steps") @db.Text
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  softDeletedAt       DateTime?      @map("soft_deleted_at") @db.Timestamptz(3)

  createdBy       User                     @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  delegatedBy     User?                    @relation("ActivityDelegatedBy", fields: [delegatedById], references: [id], onDelete: SetNull)
  responsibilities ActivityResponsibility[]
  dailyLogs       DailyLog[]
  comments        Comment[]

  @@index([createdById, status])
  @@index([startDate, endDate])
  @@index([status])
  @@index([hidden])
  @@map("activities")
}

model ActivityResponsibility {
  activityId       String @map("activity_id") @db.Uuid
  responsibilityId String @map("responsibility_id") @db.Uuid

  activity       Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  responsibility Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)

  @@id([activityId, responsibilityId])
  @@map("activity_responsibilities")
}

model DailyLog {
  id                 String         @id @default(uuid()) @db.Uuid
  activityId         String         @map("activity_id") @db.Uuid
  date               DateTime       @db.Date
  objectives         String         @default("") @db.Text
  activityDescription String        @default("") @map("activity_description") @db.Text
  transcript         String         @default("") @db.Text
  attendanceCount    String         @default("") @map("attendance_count") @db.VarChar(64)
  attendanceNotes    String         @default("") @map("attendance_notes") @db.Text
  rsvpTokenHash      String?        @unique @map("rsvp_token_hash") @db.VarChar(128)
  status             DailyLogStatus @default(pending)
  amountReleasedNgn  Decimal?       @map("amount_released_ngn") @db.Decimal(14, 2)
  amountSpentNgn     Decimal?       @map("amount_spent_ngn") @db.Decimal(14, 2)
  spendingItems      Json           @default("[]") @map("spending_items")
  submittedAt        DateTime?      @map("submitted_at") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  activity    Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  attendees   Attendee[]
  attachments Attachment[]

  @@unique([activityId, date])
  @@index([activityId])
  @@map("daily_logs")
}

model Attendee {
  id           String         @id @default(uuid()) @db.Uuid
  dailyLogId   String         @map("daily_log_id") @db.Uuid
  name         String         @db.VarChar(200)
  phone        String         @default("") @db.VarChar(40)
  email        String         @default("") @db.VarChar(255)
  source       AttendeeSource @default(manual)
  registeredAt DateTime?      @map("registered_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  @@index([dailyLogId])
  @@map("attendees")
}

model Attachment {
  id          String         @id @default(uuid()) @db.Uuid
  dailyLogId  String         @map("daily_log_id") @db.Uuid
  kind        AttachmentKind @default(evidence)
  name        String         @db.VarChar(300)
  size        Int            @default(0)
  contentType String         @default("application/octet-stream") @map("content_type") @db.VarChar(128)
  storageKey  String         @map("storage_key") @db.VarChar(512)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  @@index([dailyLogId])
  @@map("attachments")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  text       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author   User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("comments")
}

// ---------------------------------------------------------------------------
// Messaging (Phase 2)
// ---------------------------------------------------------------------------

model DirectMessage {
  id           String   @id @default(uuid()) @db.Uuid
  participantA String   @db.Uuid
  participantB String   @db.Uuid
  fromUserId   String   @map("from_user_id") @db.Uuid
  text         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  userA  User @relation("DirectMessageParticipantA", fields: [participantA], references: [id], onDelete: Cascade)
  userB  User @relation("DirectMessageParticipantB", fields: [participantB], references: [id], onDelete: Cascade)
  sender User @relation("DirectMessageSender", fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([participantA, participantB, createdAt])
  @@map("direct_messages")
}

model CommunityMessage {
  id         String   @id @default(uuid()) @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  text       String   @db.Text
  replyToId  String?  @map("reply_to_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sender   User                       @relation("CommunityMessageSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  replyTo  CommunityMessage?          @relation("CommunityMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies  CommunityMessage[]         @relation("CommunityMessageReply")
  mentions CommunityMessageMention[]

  @@index([createdAt])
  @@map("community_messages")
}

model CommunityMessageMention {
  messageId String @map("message_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  message CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User             @relation("CommunityMessageMentionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("community_message_mentions")
}

model Broadcast {
  id         String   @id @default(uuid()) @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  text       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sender User @relation("BroadcastSender", fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("broadcasts")
}

model CallRecord {
  id            String   @id @default(uuid()) @db.Uuid
  participantA  String   @map("participant_a") @db.Uuid
  participantB  String   @map("participant_b") @db.Uuid
  fromUserId    String   @map("from_user_id") @db.Uuid
  durationSec   Int      @default(0) @map("duration_sec")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  userA  User @relation("CallParticipantA", fields: [participantA], references: [id], onDelete: Cascade)
  userB  User @relation("CallParticipantB", fields: [participantB], references: [id], onDelete: Cascade)
  sender User @relation("CallFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([participantA, participantB, createdAt])
  @@map("call_records")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  text       String           @db.Text
  activityId String?          @map("activity_id") @db.Uuid
  messageId  String?          @map("message_id") @db.Uuid
  meta       Json?
  readAt     DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation("UserNotification", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditEvent {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  action     AuditAction
  targetId   String?     @map("target_id") @db.Uuid
  targetType String?     @map("target_type") @db.VarChar(64)
  meta       Json?
  ipAddress  String?     @map("ip_address") @db.VarChar(64)
  userAgent  String?     @map("user_agent") @db.VarChar(512)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([targetId])
  @@index([createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Unit Settings (Global)
// ---------------------------------------------------------------------------

model UnitSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  defaultMemberPassword String?  @map("default_member_password") @db.VarChar(255)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("unit_settings")
}
