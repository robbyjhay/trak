# =============================================================================
# Trak — environment variable template
# Copy to .env and fill in real values. Never commit real secrets.
# =============================================================================

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Trak
TRAK_RUNTIME_MODE=single # 'single' or 'multi'. 'multi' requires REDIS_URL

# Database (PostgreSQL) — required for Phase 0 auth tables
DATABASE_URL=postgresql://trak:CHANGE_ME@localhost:5433/trak?schema=public

# Redis (rate limiting, multi-instance pub/sub) — optional in local/single mode; required when TRAK_RUNTIME_MODE=multi
REDIS_URL=redis://localhost:6379

# Session / auth — TRAK_SESSION_SECRET must be ≥32 random bytes (required)
TRAK_SESSION_SECRET=GENERATE_32+_BYTE_RANDOM_STRING
SESSION_TTL_DAYS=7
BCRYPT_COST=12
ENABLE_DEV_LOGIN=false
SEED_DEMO_USERS=false

# Dev-only seed password (used only when ENABLE_DEV_LOGIN=true). Never production.
DEV_SEED_PASSWORD=

# Optional JWT (short-lived signed tokens e.g. RSVP in later phases)
TRAK_JWT_SECRET=GENERATE_32+_BYTE_RANDOM_STRING

# CSRF
CSRF_SECRET=GENERATE_32+_BYTE_RANDOM_STRING

# Email (scaffold for later phases)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Trak DLU <noreply@example.gov.ng>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Object storage (S3-compatible) — Phase 1+
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=trak-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# OAuth (reserved; not used at launch)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=
ANALYTICS_WRITE_KEY=

# Logging / monitoring
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=

# Rate limiting
RATE_LIMIT_REDIS_PREFIX=trak:rl:
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=900

# Background jobs
QUEUE_PREFIX=trak:jobs:
WORKER_CONCURRENCY=5

# Feature flags
FEATURE_WEBRTC_CALLS=false
FEATURE_BUDGET_TRACKING=true

# Data paths (legacy JSON store; remove after Phase 1 domain migration)
TRAK_DATA_DIR=
